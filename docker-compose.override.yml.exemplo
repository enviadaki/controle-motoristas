# Use este override quando for reaproveitar um host que já roda o Nginx
# Proxy Manager de outro sistema (ex.: romaneio-app-prod) — nesse caso NÃO
# suba o serviço "npm" deste projeto (ia bater porta 80/443 com o que já tá
# rodando), e sim publicar a API numa porta só de localhost pro NPM existente
# apontar pra cá, igual foi feito pro cadastro-app-prod (127.0.0.1:3001).
#
# Como usar:
#   cp docker-compose.override.yml.exemplo docker-compose.override.yml
#   # confira que a porta está livre antes: sudo ss -tlnp | grep 5001
#   docker compose up -d --build app postgres   # sem o "npm"
#
# Depois, no painel do Nginx Proxy Manager já existente (porta 81 da
# instância), crie um Proxy Host novo:
#   Domain: controle-motoristas.enviadaki.com.br
#   Forward Hostname/IP: 127.0.0.1
#   Forward Port: 5001
#   SSL: Let's Encrypt + Force SSL

services:
  app:
    ports:
      - "127.0.0.1:5001:5000"
