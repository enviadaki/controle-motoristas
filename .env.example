# Copie para .env e preencha. NUNCA versionar o .env.

# Banco (usado pelo docker-compose e pela API)
POSTGRES_USER=controle
POSTGRES_PASSWORD=troque-esta-senha
POSTGRES_DB=controle_motoristas
DATABASE_URL=postgres://controle:troque-esta-senha@postgres:5432/controle_motoristas

# Segredo para assinar o token de sessão (gere com: openssl rand -hex 32)
JWT_SECRET=

# Primeiro administrador criado pelo seed (pnpm db:seed)
ADMIN_NOME=Rafael Bezerra
ADMIN_EMAIL=rafael@enviadaki.com.br
ADMIN_SENHA=

# Porta interna da API
PORT=5000
